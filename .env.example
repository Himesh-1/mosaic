# Mosaic Environment Configuration Example
# Copy to .env for local development

# Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application URLs
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8000
API_V1_PREFIX=/api/v1

# Database (PostgreSQL 16)
# Local fallback uses sqlite+aiosqlite:///./mosaic_dev.db if PostgreSQL is not running
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mosaic
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/mosaic

# Redis 7 (Presence, Pub/Sub, Worker broker)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=mosaic-assets
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# Session and Security
SESSION_SECRET=dev-session-secret-change-me-in-production-at-least-32-chars
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# WebRTC STUN/TURN
TURN_URL=turn:localhost:3478
TURN_USERNAME=mosaic
TURN_CREDENTIAL=mosaicsecret
STUN_URL=stun:stun.l.google.com:19302

# Limits and Quotas
UPLOAD_MAX_BYTES=104857600
DIRECT_TRANSFER_MAX_BYTES=262144000
